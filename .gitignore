# macOS / Linux junk
.DS_Store
*.swp
*.swo

# Editor configs
.vscode/
.idea/

# Rust
target/
# Cargo.lock IS committed for the CLI (binary crate convention).

# Node (if any tooling sneaks in)
node_modules/
.npm-cache/

# Local env / secrets
.env
.env.local

# Build output
dist/
build/

# Local user vaults. If anyone points `memcrate` at a path inside this repo,
# their personal vault should not get committed back. The only vault that
# belongs here is the template at reference-vault/.
/vault/
/my-vault/
/memcrate-vault/

# Browser-testing artifacts
.playwright-mcp/

# leak-check tuning. Untracked on purpose: these hold private terms and
# maintainer-specific exceptions that must never ship in a public repo.
.leakcheck-vault
.leakcheck-ignore
.leakcheck-extra
